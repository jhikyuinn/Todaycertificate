# 복사해서 .env로 저장한 뒤 값을 채운다. .env는 git에 올리지 않는다.
DB_NAME=todaycertificate
DB_USERNAME=todaycert
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/todaycertificate
# JWT 서명 키. 32바이트 이상의 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me
# 화면 주소. 쉼표로 여러 개 (기본값 http://localhost:8081)
CORS_ALLOWED_ORIGINS=http://localhost:8081
